rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    function isManager() {
      return isAuth() && getRole() in ['admin', 'project_manager'];
    }

    function isLead() {
      return isAuth() && getRole() in ['admin', 'project_manager', 'team_lead'];
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // ── Teams ─────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Departments ────────────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Tasks ──────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuth();
      allow create: if isManager() || isLead();
      allow update: if isLead()
        || resource.data.assigneeIds.hasAny([request.auth.uid]);
      allow delete: if isAdmin();

      // Task Comments
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isOwner(resource.data.authorId);
        allow delete: if isAdmin() || isOwner(resource.data.authorId);
      }

      // Task History (written by Cloud Functions)
      match /history/{historyId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    // ── Standups ────────────────────────────────────────────────────────
    match /standups/{standupId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isLead();
      allow delete: if isAdmin();
    }

    // ── Help Requests ────────────────────────────────────────────────────
    match /help_requests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isLead() || isOwner(resource.data.requesterId);
      allow delete: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow create, delete: if false; // Cloud Functions only
    }

    // ── Audit Logs ────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isLead();
      allow write: if false; // Cloud Functions only
    }
  }
}
